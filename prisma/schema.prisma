datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  records   Record[]
}

model Record {
  id            String   @id @default(uuid())
  title         String
  description   String?
  processedData String? // Aquí guardaremos la respuesta del servicio propietario (ej. IA o nube)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}
